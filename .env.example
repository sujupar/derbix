# Copy to .env (which is gitignored) and fill in real values.
# All keys here are PUBLIC by design (Vite inlines VITE_* into the bundle).
# NEVER add a SUPABASE_SERVICE_ROLE_KEY or any other secret here.

# Supabase (frontend / scripts)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ─── Server-side / scripts only ─────────────────────────────────────
# These are loaded by Node scripts in scripts/. They are NOT exposed to
# the browser. Keep them out of the bundle by never prefixing with VITE_.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Sportmonks (server scripts)
API_FOOTBALL_KEY=your_api_football_key
SPORTMONKS_API_KEY=your_sportmonks_token

# ─── Edge function secrets (DO NOT put in .env) ─────────────────────
# These live as Supabase Edge Function secrets, set with:
#   npx supabase secrets set NAME=VALUE
#
# Required:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_ANON_KEY
#   INTERNAL_FUNCTION_SECRET   ← used by the auth-guard for service-to-service calls
#   GROQ_API_KEY
#   GEMINI_API_KEY
#   PERPLEXITY_API_KEY
#   WHOP_API_KEY
#   WHOP_WEBHOOK_SECRET
#   LS_API_KEY
#   LS_WEBHOOK_SECRET
#   WOMPI_EVENT_SECRET
#   META_PIXEL_ID
#   META_CONVERSIONS_TOKEN
#   RESEND_API_KEY
#   ADMIN_NOTIFICATION_EMAILS    (comma-separated)
#   WHATSAPP_PHONE_NUMBER_ID
#   WHATSAPP_ACCESS_TOKEN
#   FRONTEND_URL=https://derbix.co
